global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_wb_automation {
    script "/usr/local/bin/wb-ha-healthcheck.sh"
    interval 2
    weight -60
    fall 2
    rise 2
}

vrrp_instance VI_WB_PAIR {
    # dont_track_primary характерен для случая подключения по Wi-Fi — без
    # него keepalived уходит в FAULT при любом кратковременном дребезге
    # интерфейса (переассоциация Wi-Fi) и не восстанавливается сам. На
    # Ethernet-линке такого дребезга обычно нет, директива может не
    # понадобиться.
    dont_track_primary
    state BACKUP
    interface wlan0
    virtual_router_id 51
    priority 100
    advert_int 1
    # unicast_src_ip/unicast_peer вместо мультикаста по умолчанию —
    # тоже характерно для Wi-Fi: точка доступа часто режет мультикаст-
    # трафик между клиентами. В проводной сети обычно можно оставить
    # VRRP на мультикасте.
    unicast_src_ip 192.168.143.112
    unicast_peer {
        192.168.143.111
    }
    authentication {
        auth_type PASS
        auth_pass wbha1
    }
    virtual_ipaddress {
        192.168.143.115/24
    }
    track_script {
        chk_wb_automation
    }
    notify_master "/usr/local/bin/wb-ha-notify.sh active"
    notify_backup "/usr/local/bin/wb-ha-notify.sh standby"
    notify_fault  "/usr/local/bin/wb-ha-notify.sh fault"
    preempt_delay 5
}

global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_wb_automation {
    script "/usr/local/bin/wb-ha-healthcheck.sh"
    interval 2
    weight -60
    fall 2
    rise 2
}

vrrp_instance VI_WB_PAIR {
    # dont_track_primary нужен при подключении по Wi-Fi: без него при
    # кратковременном пропадании интерфейса (переподключение к Wi-Fi)
    # keepalived переходит в FAULT и сам из него не выходит. При проводном
    # подключении обычно не нужен.
    dont_track_primary
    state BACKUP
    # Имя интерфейса и IP-адреса ниже (unicast_src_ip, unicast_peer, virtual_ipaddress) замените на свои.
    interface wlan0
    virtual_router_id 51
    priority 100
    advert_int 1
    # unicast_src_ip/unicast_peer вместо мультикаста по умолчанию нужны при
    # подключении по Wi-Fi: точки доступа часто блокируют мультикаст-трафик
    # между клиентами. При проводном подключении VRRP обычно может работать
    # на мультикасте.
    unicast_src_ip 192.168.143.112
    unicast_peer {
        192.168.143.111
    }
    authentication {
        auth_type PASS
        auth_pass wbha1
    }
    virtual_ipaddress {
        192.168.143.115/24
    }
    track_script {
        chk_wb_automation
    }
    notify_master "/usr/local/bin/wb-ha-notify.sh active"
    notify_backup "/usr/local/bin/wb-ha-notify.sh standby"
    notify_fault  "/usr/local/bin/wb-ha-notify.sh fault"
    preempt_delay 5
}

# Пример для стадии 2 (синхронизация уставок между узлами).
# Ставится ТОЛЬКО на одной стороне (например, на узле с priority 150) -
# если прописать такой же connection на обеих сторонах, получаются ДВА
# параллельных bridge-соединения друг в друга (видно в journalctl -u
# mosquitto как повторные "Connecting bridge"/"closed its connection"),
# риск дублирования сообщений.
#
# Бриджится не сам control, а отдельный sync-топик с value+ts -
# см. wb-rules/README.md про last-write-wins и почему голый mirror
# retained-топика недостаточен.
connection wb-ha-sync
address 192.168.143.112:1883
topic /wbha/sync/<CONTROL_NAME> both 1
cleansession true
notifications false
start_type automatic
restart_timeout 5

# Пример для стадии 2 (синхронизация уставок между узлами).
# Устанавливается только на одном узле (например, с priority 150). Если
# прописать такое же подключение на обоих узлах, между ними поднимаются два
# параллельных bridge-соединения (в journalctl -u mosquitto видны повторные
# "Connecting bridge"/"closed its connection"), и сообщения могут дублироваться.
#
# Через bridge передаётся отдельный sync-топик со значением и меткой времени
# (value+ts), сам control не передаётся. Почему простого зеркалирования
# retained-топика недостаточно, описано в wb-rules/setpoint_sync_template.js.
connection wb-ha-sync
address 192.168.143.112:1883
topic /wbha/sync/<CONTROL_NAME> both 1
cleansession true
notifications false
start_type automatic
restart_timeout 5
